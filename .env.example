# Conexion a PostgreSQL (Supabase). Usar el connection string del pooler.
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Clave para firmar la sesion de usuario (cookie httpOnly). Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia_esta_clave_por_una_aleatoria_de_96_caracteres
