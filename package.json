{
  "name": "profe-padel-pro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate-db.js",
    "test:build": "tsc lib/sync-client.ts --outDir .tmp-test --module commonjs --target es2022 --moduleResolution node --skipLibCheck",
    "test:schedule:build": "tsc lib/schedule.ts scripts/test-schedule.ts --outDir .tmp-sched --module commonjs --target es2022 --moduleResolution node --skipLibCheck",
    "test:schedule": "npm run test:schedule:build && node .tmp-sched/scripts/test-schedule.js",
    "test": "npm run test:build && npm run test:schedule && node scripts/test-sync.js && node scripts/test-engine.js && node scripts/test-app.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
